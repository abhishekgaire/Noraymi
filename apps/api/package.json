    "@west4/rules": "workspace:*",
    "@west4/shared": "workspace:*",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.0",
    "playwright-core": "1.63.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
