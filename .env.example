# Copy to .env for local development. Every real value comes from the
# environment or the secrets manager; nothing secret is ever committed.

# Postgres (docker-compose.yml). DATABASE_URL is the table owner: migrations
# and db:reset. APP_DATABASE_URL is app_rw, what the API connects as: no
# BYPASSRLS, no delete, 5-second limits (spec 02 · The database walls).
DATABASE_URL=postgres://west4:west4@localhost:5432/west4
APP_DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/west4

# Local S3-compatible store (docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=west4
S3_SECRET_ACCESS_KEY=west4secret
S3_BUCKET_FILES=west4-files
S3_BUCKET_AUDIT=west4-audit

# Stripe (M4-01). While any of these is unset or replace_me, the API sends every
# Stripe call to the fake Stripe (`pnpm --filter @west4/api stripe:fake`, port
# 12111) and nothing reaches Stripe. With a sandbox: one restricted key per
# service from the Dashboard's test mode (Developers → API keys → restricted).
STRIPE_KEY_PAYMENTS=rk_test_replace_me
STRIPE_KEY_REFUNDS=rk_test_replace_me
STRIPE_KEY_REPORTING=rk_test_replace_me
STRIPE_KEY_BILLING=rk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Each endpoint's own signing secret: `stripe listen --forward-connect-to localhost:3000/v1/hooks/stripe/connect` and so on.
STRIPE_WEBHOOK_SECRET_READERS=whsec_replace_me
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_replace_me
STRIPE_WEBHOOK_SECRET_PLATFORM=whsec_replace_me
# STRIPE_API_BASE=http://127.0.0.1:12111   # where calls go (the fake's address by default when no keys are set)

# Twilio test credentials (Console → Account → API keys & tokens → Test credentials).
# Test credentials can't send real texts, which is the point in development.
TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15005550006

# Rule packs (M1-10). Locally a throwaway key signs the built-in pack at
# db:migrate when this is unset; staging holds an Ed25519 PEM in Secrets Manager.
# RULE_PACK_SIGNING_KEY=
RULE_PACK_APPROVERS=Abhishek Gaire,Claude Code

# Email (M1-18). Locally the mail catcher in docker-compose.yml (inbox at
# http://localhost:8025). On staging and production SMTP_URL is the transactional
# provider's SMTP relay (smtp://user:pass@host:587 or smtps://…:465), the
# founder's pick. EMAIL_ALLOW_LIST is staging only: a comma-separated list of
# our own addresses and @domains; staging sends to nothing else, and an empty
# list sends nothing at all.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="West 4 <no-reply@west4.local>"
EMAIL_ALLOW_LIST=
# Apps. WEST4_ENV is local, staging or production. ALLOW_STAGING_FEATURES=true
# turns on the simulated clock (POST /v1/ops/clock) and the demo PINs; the API
# refuses to start with it in production.
# Sign-in (M1-19). The key seals authenticator-app secrets; this value is the fixed local
# development key the API falls back to, refused outside WEST4_ENV=local. Staging and
# production take theirs from the secrets manager (infra/scripts/seed-secrets.sh).
AUTH_SECRET_KEY=6c6f63616c2d6465762d6b65792d6e6f742d666f722d73746167696e672d2121
# Passkeys are bound to the staff app's domain and accepted from these origins.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Lax when the staff app and the API share a site (local); None (with Secure) when they don't.
SESSION_COOKIE_SAME_SITE=Lax
WEST4_ENV=local
ALLOW_STAGING_FEATURES=true
PORT=3000
STAFF_URL=http://localhost:5173

# Web push (M1-22). Local development has a built-in local-only VAPID pair (apps/api/src/push/settings.ts);
# staging and production set their own: `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@west4.local

# Where invite links open (M1-23): the staff app's public URL. Local dev defaults to the Vite server.
STAFF_APP_URL=http://localhost:5173

# The Console (M1-35): our staff's tool on its own hostname. Security keys bind to CONSOLE_URL's host.
# Single sign-on is any OpenID Connect provider; with none set, local development signs in by email
# before the security-key step, and staging and production refuse to start.
CONSOLE_URL=http://localhost:5174
CONSOLE_OIDC_ISSUER=
CONSOLE_OIDC_CLIENT_ID=
CONSOLE_OIDC_CLIENT_SECRET=

# Guest texts from each venue's own Twilio subaccount (M2-09). Locally they're recorded, not sent, unless
# GUEST_TEXTS=twilio. PUBLIC_API_URL is where Twilio sends status callbacks. Staging texts only TEXT_ALLOW_LIST.
GUEST_TEXTS=
PUBLIC_API_URL=
TEXT_ALLOW_LIST=

# Where a room's join link opens (M2-11): the guest site. Local defaults to the Next server.
GUEST_APP_URL=http://localhost:3001
# The payment page's own origin (M4-15); the guest app serves /pay only on this host.
PAY_APP_URL=http://pay.localhost:3001
