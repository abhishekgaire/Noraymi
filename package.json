{
  "name": "west4-karaoke",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "22.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "build:packages": "tsc -b",
    "dev": "tsc -b && pnpm -r --parallel --stream run dev",
    "lint": "eslint . && prettier --check . && bash scripts/check-stripe-versions.sh",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check": "bash scripts/check.sh",
    "format": "prettier --write .",
    "typecheck": "tsc -b && pnpm -r --parallel run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsc -b && vitest run",
    "test:integration": "tsc -b && vitest run --config vitest.integration.config.ts",
    "test:principals": "tsc -b && vitest run --config vitest.integration.config.ts --project api:integration apps/api/src/security/principals apps/api/src/security/planted-leak",
    "test:walls": "tsc -b && vitest run --config vitest.integration.config.ts --project api:integration apps/api/src/security/walls apps/api/src/security/planted-leak",
    "e2e": "tsc -b && playwright test",
    "db:migrate": "tsc -b packages/db && node packages/db/dist/cli.js migrate",
    "db:reset": "tsc -b packages/db && node packages/db/dist/cli.js reset",
    "db:lint": "tsc -b packages/db && node packages/db/dist/lint-cli.js",
    "seed": "tsc -b packages/db && node packages/db/dist/cli.js seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@west4/shared": "workspace:*",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
